{
  "compilerOptions": {
    "target": "ES2017",
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": [
        "./*"
      ]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts",
    "**/*.mts",
    ".next-pau/types/**/*.ts",
    ".next-pau/dev/types/**/*.ts",
    ".next-nantes/types/**/*.ts",
    ".next-nantes/dev/types/**/*.ts",
    ".next-brest/types/**/*.ts",
    ".next-brest/dev/types/**/*.ts",
    ".next-bordeaux/types/**/*.ts",
    ".next-bordeaux/dev/types/**/*.ts",
    ".next-rennes/types/**/*.ts",
    ".next-rennes/dev/types/**/*.ts",
    ".next-test/types/**/*.ts",
    ".next-test/dev/types/**/*.ts",
    ".next-chk-nantes/types/**/*.ts",
    ".next-chk-nantes/dev/types/**/*.ts",
    ".next-chk-brest/types/**/*.ts",
    ".next-chk-brest/dev/types/**/*.ts",
    ".next-chk-pau/types/**/*.ts",
    ".next-chk-pau/dev/types/**/*.ts",
    ".next-chk-bordeaux/types/**/*.ts",
    ".next-chk-bordeaux/dev/types/**/*.ts",
    ".next-chk-rennes/types/**/*.ts",
    ".next-chk-rennes/dev/types/**/*.ts"
  ],
  "exclude": [
    "node_modules"
  ]
}
